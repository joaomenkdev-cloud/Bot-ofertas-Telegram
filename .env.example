# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore: nunca faça commit dele.

# Token do bot (no Telegram: @BotFather → /newbot)
BOT_TOKEN=

# ID do grupo/canal onde as ofertas serão postadas (normalmente começa com -100)
GROUP_CHAT_ID=

# IDs numéricos de quem pode usar /buscar, /status e /config, separados por vírgula.
# Descubra o seu mandando qualquer mensagem para o @userinfobot.
ADMIN_IDS=

# (Opcional) Caminho do banco SQLite. Padrão: ofertas.db na raiz do projeto
# DB_PATH=
